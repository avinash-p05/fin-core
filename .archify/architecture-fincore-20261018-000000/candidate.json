    "cards": [
        {
            "dot": "cyan",
            "title": "Money correctness",
            "items": [
                "Fraud decision precedes balance changes",
                "Accounts locked in a fixed order: no overdraft, no deadlock",
                "Payment, ledger entries and outbox row commit in one PostgreSQL transaction",
                "Double-entry and immutability enforced in application and database"
            ]
        },
        {
            "dot": "emerald",
            "title": "Reliable events",
            "items": [
                "Relay claims outbox rows with SKIP LOCKED and pipelines Kafka sends",
                "At-least-once delivery with exponential backoff; failures parked, never dropped",
                "Consumer dedupes on processed_events in the same transaction as its effect",
                "3 bounded retries, then fincore.payment-events.DLT"
            ]
        },
        {
            "dot": "rose",
            "title": "Operational boundary",
            "items": [
                "HTTP Basic users are local-development authentication",
                "Only ANALYST can approve or reject held payments",
                "Redis down: payments are held for REVIEW, never auto-approved",
                "Kafka is downstream of the payment commit"
            ]
        },
        {
            "dot": "violet",
            "title": "Load test · k6 · one laptop",
            "items": [
                "~1,019 payments/s, p95 87 ms, 0 errors (50 VUs, 100 accounts, BCrypt 4)",
                "~161 payments/s, p95 595 ms with default BCrypt 10: HTTP Basic hashes on every request",
                "One hot account: ~265/s; 3,998 debits settled, 11,885 rejected, no overdraft",
                "Outbox relay 133 → 2,800+ events/s after pipelining; consumer ~1,041 events/s"
            ]
        },
        {
            "dot": "orange",
            "title": "Integrity after 211,878 payments",
            "items": [
                "Ledger verification VALID: 200,563 transactions, debits = credits",
                "0 balance mismatches, 0 negative balances",
                "199,993 completed = published = consumed; 0 duplicate notifications",
                "65/65 automated tests on real PostgreSQL, Redis and Kafka"
            ]
        }
    ]
