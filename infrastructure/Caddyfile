# Public entry point (standalone mode): automatic HTTPS (Let's Encrypt) in front of the single
# FinCore container, which serves the dashboard at / and the API at /api on port 8080.
{$FINCORE_DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	reverse_proxy backend:8080
}
