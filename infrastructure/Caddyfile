# Public entry point: automatic HTTPS (Let's Encrypt) in front of the dashboard container,
# which already proxies /api to the backend.
{$FINCORE_DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	reverse_proxy frontend:80
}
