# Copy to .env and fill in. Never commit the real file (.env is git-ignored).
# Generate passwords with: openssl rand -base64 18

# Must match the password given to ~/platform/create-app-db.sh fincore
FINCORE_DB_PASSWORD=change-me
# Shared with recruiters (the demo login needs no password at all)
FINCORE_OPERATOR_PASSWORD=change-me
# Keep private: can approve or reject held payments
FINCORE_ANALYST_PASSWORD=change-me

# Server: the public address the edge serves FinCore on.
# Laptop: leave commented out (defaults to the Vite dev server, http://localhost:5173).
# FINCORE_ALLOWED_ORIGINS=https://fin-core.duckdns.org

# Which image tag to run (default latest). Roll back by setting a commit SHA from GitHub, then ./deploy.sh
# FINCORE_IMAGE_TAG=latest
